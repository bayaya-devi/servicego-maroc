# Leave these blank to run the complete local product flow without email delivery.
# Add them only after Brevo has verified the sender address.
BREVO_API_KEY=
BREVO_FROM_EMAIL="aetbconseil@gmail.com"

# Optional: enable Turnstile validation on account creation in production.
# The site key is public; the secret must only be stored with `wrangler secret put`.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
