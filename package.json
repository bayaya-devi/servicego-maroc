{
  "name": "servicego-maroc",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ServiceGO - marketplace de services pour tout le Maroc",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "test": "node --test tests/*.test.mjs",
    "test:security": "node --test tests/security-http.test.mjs",
    "test:visual": "node tests/visual-premium.cjs",
    "test:e2e": "playwright test",
    "test:e2e:staging": "cross-env SERVICEGO_E2E_URL=https://servicego-maroc-staging.aetbconseil.workers.dev playwright test",
    "build:client": "node scripts/build-client.mjs",
    "predeploy": "npm run build:client",
    "test:story": "node tests/visual-story-fix.cjs",
    "test:quality": "node tests/quality-audit.mjs",
    "typecheck": "tsc --noEmit --skipLibCheck --target ES2022 --module ESNext --moduleResolution Bundler --lib ES2022,WebWorker --types ./worker-configuration.d.ts worker/index.ts",
    "check": "wrangler types",
    "types": "wrangler types",
    "db:local": "wrangler d1 migrations apply servicego-production --local",
    "db:remote": "wrangler d1 migrations apply servicego-production --remote",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.2",
    "chrome-launcher": "^1.2.2",
    "cross-env": "^7.0.3",
    "lighthouse": "^13.5.0",
    "miniflare": "5.20261019.1-beta",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.151.3"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "three": "^0.180.0"
  },
  "overrides": {
    "sharp": "0.35.5",
    "undici": "7.29.1"
  }
}
